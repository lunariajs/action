{
  "name": "@lunariajs/action",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "description": "Lunaria GitHub Action",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "imports": {
    "jiti": "./node_modules/jiti/lib/jiti-static.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Yan Thomas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lunariajs/action"
  },
  "bugs": "https://github.com/lunariajs/action/issues",
  "scripts": {
    "build": "pkgroll --target=node24 --minify",
    "format": "biome check --write",
    "lint": "tsc",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile && pnpm format",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@lunariajs/core": "^0.2.0",
    "jiti": "^2.7.0",
    "markdown-table": "^3.0.3"
  },
  "dependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "pkgroll": "^2.0.1",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@12.18.0"
}
